# Copy to .env and fill in. Everything is optional — without a key the app runs on the placeholder data in data/*.csv.

# ── Live data: Artificial Analysis ─────────────────────────────────────────────
# Free key: https://artificialanalysis.ai/  (Data API). Free tier = 100 requests/day;
# one refresh uses 1–2. Attribution is shown automatically in the site footer.
AA_API_KEY=
# free → Intelligence Index, prices, speed, latency, release dates
# pro  → also GPQA Diamond, MMMU-Pro and context window (needs a Pro key)
AA_TIER=free
# Also track the N best-ranked AA models that aren't in data/models.csv (0 = off)
AA_IMPORT_TOP=0
# Link a model by hand when names differ: our-model-id=aa-slug,other-id=other-slug
AA_ALIASES=

# Chat webhook (Slack, Discord, Teams, Google Chat) pinged when live data changes.
NOTIFY_WEBHOOK_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
# Folder with models.csv, benchmarks.csv, scores.csv, runs.csv, changes.csv
DATA_DIR=data
# Hours between automatic refreshes while the server runs (0 = never)
REFRESH_HOURS=24
# Required for "Refresh now" from other machines (e.g. when deployed). Local refresh works without it.
ADMIN_TOKEN=

# ── Frontend (read at build time by Vite) ─────────────────────────────────────
# auto (local API → bundled CSV) | api | static   (`npm run build:static` sets static)
VITE_DATA_PROVIDER=auto
# Point the site at an API on another origin (leave empty when served together)
VITE_API_BASE=
