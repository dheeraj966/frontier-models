{
  "name": "frontier-model-viz",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:static": "vite build --mode static",
    "start": "tsx server/index.ts --serve-static",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check:data": "tsx scripts/check-data.ts",
    "ingest": "tsx server/cli/ingest.ts",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run check:data && npm test && npm run build:static"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.12.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
